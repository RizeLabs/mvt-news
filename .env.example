ANTHROPIC_API_KEY=your_anthropic_api_key_here

# From @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: a channel (@yourchannel or -100…) or your own user id that receives EVERY alert + digest.
# Users can also just /start the bot to subscribe individually.
TELEGRAM_CHAT_ID=
# Optional: comma-separated Telegram user ids allowed to use the bot. Empty = public.
TELEGRAM_ALLOWED_USERS=

# Optional tuning (defaults shown)
NEWS_POLL_MINUTES=15
REDDIT_POLL_MINUTES=5
MIN_DIGEST_SCORE=5
MIN_ALERT_SCORE=8
MAX_ALERTS_PER_HOUR=15
DIGEST_TIME_IST=23:30
# CLASSIFIER_MODEL=claude-haiku-4-5
# ASK_MODEL=claude-opus-5-5

# Optional: where the SQLite file lives (default ./news.db). On Railway use a volume, e.g. /data/news.db
DB_PATH=
